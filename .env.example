# Portal da plataforma — copie para .env (o .env não vai para o repositório)

PORT=3030
# NODE_ENV=production   # em nuvem (exige DATABASE_URL e SEGREDO_PLATAFORMA)
# DATABASE_URL=postgres://usuario:senha@host:5432/banco
# DADOS_DIR=./dados     # PGlite local quando não há DATABASE_URL
# HOST=127.0.0.1

# Login do portal (o portal sempre tem login próprio; AUTH_MODO é variável dos módulos)
COOKIE_SESSAO=portal_sessao
# ADMIN_EMAIL=
# ADMIN_SENHA=
# ADMIN_NOME=
MODO_TESTE=1            # só local; ignorado em nuvem

# Segredo que assina o token da plataforma: o MESMO valor em todos os módulos (32+ caracteres).
# No Railway, uma variável compartilhada do projeto.
SEGREDO_PLATAFORMA=troque-por-um-segredo-com-32-caracteres-ou-mais

# Módulos: id=endereço interno (ou id@/prefixo=endereço), separados por vírgula.
# O prefixo vem do manifesto (/modulo.json) de cada módulo; o "@/prefixo" só fixa outro.
# No Railway: http://<servico>.railway.internal:<porta>
MODULOS=cronogramas=http://127.0.0.1:3232,orcamentos=http://127.0.0.1:3333
